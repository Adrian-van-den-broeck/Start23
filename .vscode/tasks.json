{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wombo: Switch to local mode",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\set-start23-mode.ps1",
        "-Mode",
        "local"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Wombo: Switch to production mode",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\set-start23-mode.ps1",
        "-Mode",
        "production"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Wombo: Start Android emulator",
      "type": "shell",
      "command": "Start-Process -FilePath \"${env:ANDROID_HOME}\\emulator\\emulator.exe\" -ArgumentList '-avd','${input:androidAvd}','-no-snapshot-load'",
      "options": {
        "env": {
          "ANDROID_USER_HOME": "${env:USERPROFILE}\\.android"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Wombo: Stop Android emulator",
      "type": "shell",
      "command": "& \"${env:ANDROID_HOME}\\platform-tools\\adb.exe\" emu kill",
      "options": {
        "env": {
          "ANDROID_USER_HOME": "${env:USERPROFILE}\\.android"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Wombo: Start backend",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\start-start23-backend.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "start23-backend",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Backend target:.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "Wombo: Configure Android bridges",
      "type": "shell",
      "command": "& \"${env:ANDROID_HOME}\\platform-tools\\adb.exe\" reverse tcp:8081 tcp:8081; & \"${env:ANDROID_HOME}\\platform-tools\\adb.exe\" reverse tcp:8000 tcp:8000",
      "options": {
        "env": {
          "ANDROID_USER_HOME": "${env:USERPROFILE}\\.android"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Wombo: Run Android app",
      "type": "shell",
      "command": "npm run android -- --localhost",
      "options": {
        "cwd": "${workspaceFolder}\\mobile",
        "env": {
          "NODE_OPTIONS": "--dns-result-order=ipv4first"
        }
      },
      "dependsOn": [
        "Wombo: Start backend",
        "Wombo: Configure Android bridges"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Wombo: Build Play Store AAB",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-start23-playstore.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "androidAvd",
      "type": "promptString",
      "description": "Android Virtual Device name",
      "default": "Pixel_4_API_35"
    }
  ]
}
