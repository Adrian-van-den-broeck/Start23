# Copy this file to .env and use the public key from:
# Supabase Dashboard > Connect (or Settings > API Keys) > Publishable key.
# Never place a secret or service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://isfumhgqphieoayqahjv.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# The VS Code "Start23: Run Android app" task starts FastAPI and configures
# reverse bridges for both Metro (8081) and the API (8000).
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
