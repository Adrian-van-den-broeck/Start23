{
  "cli": {
    "version": ">= 21.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "wombo": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "wombo": {
      "android": {
        "serviceAccountKeyPath": "./credentials-google-play.json",
        "track": "internal"
      }
    }
  }
}
