{
  "cli": {
    "version": ">= 21.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    },
    "wombo": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "wombo"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
